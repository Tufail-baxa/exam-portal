NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_portal?schema=public

# Auth — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

# Grace window (seconds) allowed for answers that arrive just after the timer
SUBMIT_GRACE_SECONDS=10

# Optional infrastructure
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail / SMS providers (verification + password reset)
MAIL_FROM=no-reply@example.com
SMTP_URL=
